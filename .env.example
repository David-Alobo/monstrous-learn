# The course's passwords and database addresses, kept out of the code.
#
# Copy this file to a new file called .env, in this same folder (the repository's root), and
# replace each change-me with a password of your own (letters and digits; at least 8 characters).
# Docker Compose reads .env to set up the databases, and the lessons read it to log in to them.
# .env is listed in .gitignore, so Git never stores it: keep it that way, and never share it.
# The guide shared/docker/README.md (also at monstrous.com.ng/learn/databases/) shows each step.

# PostgreSQL (Module 4)
POSTGRES_USER=learn
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=chem
# the address the lessons connect to; it is built from the three lines above
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}
# the read-only colleague's account that Module 4 creates
ANALYST_PASSWORD=change-me-analyst

# Neo4j (Module 5)
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-neo4j
NEO4J_URI=bolt://localhost:7687
